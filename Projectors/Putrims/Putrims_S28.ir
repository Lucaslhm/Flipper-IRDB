Filetype: IR signals file
Version: 1
#
# PUTRIMS S28 Mini Projector
# OEM: Yaber Technologies Co., Ltd (per Declaration of Conformity in manual)
# NECext, address 0x6B86 - identical code set to Groview / TOPTRO remotes
# https://www.amazon.com/dp/B0D95Q4KKH
# 15 physical buttons; Wifi (0x1F) and Play_Pause (0x09) are live but keyless.
#
name: Power
type: parsed
protocol: NECext
address: 86 6B 00 00
command: 0A F5 00 00
