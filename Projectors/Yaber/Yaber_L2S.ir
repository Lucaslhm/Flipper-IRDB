Filetype: IR signals file
Version: 1
# Yaber L2S projector - owner-tested with Flipper Zero Momentum and XRemote
# All 11 commands confirmed working on an L2s; other models unverified
# NEC protocol, address 02 00 00 00
# Ok=0x15; Ok_alt=0x16 (both tested as Enter/Submit).
#
name: Power
type: parsed
protocol: NEC
address: 02 00 00 00
command: 14 00 00 00
