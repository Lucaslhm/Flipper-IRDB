Filetype: IR signals file
Version: 1
#
# Yaber Y23 projector
# Captured from the original remote (IR photodiode into a sound card at
# 192 kHz) and decoded to NECext; all 15 buttons verified on the hardware.
# Carrier is assumed 38 kHz: the capture chain filtered the carrier out,
# so it was not measured directly.
#
name: Power
type: parsed
protocol: NECext
address: B8 57 00 00
command: 0C F3 00 00
#
name: Mute
type: parsed
protocol: NECext
address: B8 57 00 00
command: 0D F2 00 00
#
name: Vol_up
type: parsed
protocol: NECext
address: B8 57 00 00
command: 1F E0 00 00
#
name: Vol_dn
type: parsed
protocol: NECext
address: B8 57 00 00
command: 1E E1 00 00
#
name: Bright_mode
type: parsed
protocol: NECext
address: B8 57 00 00
command: 1D E2 00 00
#
name: Menu
type: parsed
protocol: NECext
address: B8 57 00 00
command: 16 E9 00 00
#
name: Input
type: parsed
protocol: NECext
address: B8 57 00 00
command: 0E F1 00 00
#
name: Up
type: parsed
protocol: NECext
address: B8 57 00 00
command: 10 EF 00 00
#
name: Down
type: parsed
protocol: NECext
address: B8 57 00 00
command: 14 EB 00 00
#
name: Left
type: parsed
protocol: NECext
address: B8 57 00 00
command: 11 EE 00 00
#
name: Right
type: parsed
protocol: NECext
address: B8 57 00 00
command: 13 EC 00 00
#
name: Ok
type: parsed
protocol: NECext
address: B8 57 00 00
command: 12 ED 00 00
#
name: Back
type: parsed
protocol: NECext
address: B8 57 00 00
command: 17 E8 00 00
#
name: Keystone
