Filetype: IR signals file
Version: 1
#
# Gaimoo GM300 projector (Android TV based mini projector)
# Original IR remote. Captured with a Broadlink RM4 pro and decoded to NEC (all checksums valid).
# Power toggles on/standby; a short press while on shows a confirmation dialog.
# Screen_mirror opens the Transcreen app. Mouse toggles the remote's mouse mode.
#
name: Power
type: parsed
protocol: NEC
address: 00 00 00 00
command: 14 00 00 00
#
name: Up
type: parsed
protocol: NEC
address: 00 00 00 00
command: 03 00 00 00
#
