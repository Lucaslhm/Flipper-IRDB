Filetype: IR signals file
Version: 1
#
# Igenix portable air conditioner remote
# Model: IG9901WIFI
# Protocol: NEC, address 0x00
# Remote uses independent button commands rather than full-state HVAC frames.
# Temp_up and Temp_dn are relative increment/decrement commands.
#
name: Power
type: parsed
protocol: NEC
address: 00 00 00 00
command: 45 00 00 00
#
name: Oscillate
type: parsed
protocol: NEC
address: 00 00 00 00
command: 47 00 00 00
#
name: Temp_up
type: parsed
protocol: NEC
address: 00 00 00 00
command: 07 00 00 00
#
name: Mode
type: parsed
protocol: NEC
address: 00 00 00 00
command: 09 00 00 00
#
name: Temp_dn
type: parsed
protocol: NEC
address: 00 00 00 00
command: 0C 00 00 00
#
name: Fan_speed
type: parsed
protocol: NEC
address: 00 00 00 00
command: 5E 00 00 00
#
name: Timer
type: parsed
protocol: NEC
address: 00 00 00 00
command: 42 00 00 00
#
name: Sleep
type: parsed
protocol: NEC
address: 00 00 00 00
command: 4A 00 00 00
