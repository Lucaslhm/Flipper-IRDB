name: Up
type: parsed
protocol: NECext
address: BE BD 00 00
command: 07 F8 00 00
#
name: Down
type: parsed
protocol: NECext
address: BE BD 00 00
command: 06 F9 00 00
#
name: Eq
type: parsed
protocol: NECext
address: BE BD 00 00
command: 08 F7 00 00
#
name: Mode
type: parsed
protocol: NECext
address: BE BD 00 00
command: 0B F4 00 00
#
name: Vol_up
