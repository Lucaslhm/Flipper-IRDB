Filetype: IR signals file
Version: 1
#
# Livarno HG10508A - LED colour-changing bulb (Lidl / Livarno home)
# IR remote, NEC, address 00. Codes are the common OEM 24-key RGB set,
# verified working on the physical Livarno HG10508A bulb (all buttons).
# Physical remote has 20 keys; this is the full 24-code superset.
#
name: Power_on
type: parsed
protocol: NEC
address: 00 00 00 00
command: 0D 00 00 00
#
name: Power_off
type: parsed
protocol: NEC
address: 00 00 00 00
command: 1F 00 00 00
#
name: Brightness_up
type: parsed
protocol: NEC
address: 00 00 00 00
command: 09 00 00 00
#
name: Brightness_dn
type: parsed
protocol: NEC
address: 00 00 00 00
command: 1D 00 00 00
